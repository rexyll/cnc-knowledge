{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rexyll/cnc-knowledge/blob/main/docs/data-model/entity.schema.json",
  "title": "CNC Knowledge Entity Record",
  "description": "通用知识实体记录。类型专属属性放入attributes；实体关系使用独立relationship record。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity_id",
    "entity_type",
    "canonical_name",
    "description",
    "primary_chapter",
    "lifecycle_status",
    "verification_status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "pattern": "^(KNOW|TERM|MTYPE|MACHINE|MINST|VENDOR|BRAND|PRODUCT|SUBSYS|PART|MAT|PROCESS|TOOL|FIXTURE|SOFTWARE|ALGO|PROTO|INTERFACE|SIGNAL|PARAM|METRIC|STD|TEST|MEAS|BOM|DOC|ASSET|PROC|FAULT|ALARM|CASE|APP)-[0-9]{6}$"
    },
    "entity_type": {
      "type": "string",
      "enum": [
        "knowledge_article",
        "term",
        "machine_type",
        "machine_model",
        "machine_instance",
        "organization",
        "brand",
        "product_model",
        "subsystem",
        "part",
        "material",
        "process",
        "tooling",
        "fixture",
        "software",
        "algorithm",
        "protocol",
        "interface",
        "signal",
        "parameter",
        "metric",
        "standard",
        "test_method",
        "measurement_record",
        "bom",
        "document_record",
        "asset_file",
        "procedure",
        "fault_mode",
        "alarm_code",
        "case_study",
        "application"
      ]
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "english_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "primary_chapter": {
      "type": "string",
      "pattern": "^CH(0[1-9]|1[0-9]|2[0-2])$"
    },
    "related_chapters": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CH(0[1-9]|1[0-9]|2[0-2])$"
      },
      "uniqueItems": true
    },
    "classification_path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "candidate",
        "active",
        "deprecated",
        "merged",
        "archived"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "unverified",
        "in_review",
        "verified",
        "disputed",
        "rejected"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SRC-[0-9]{6}$"
      },
      "uniqueItems": true
    },
    "attributes": {
      "type": "object"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
